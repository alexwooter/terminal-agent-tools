{
  "name": "terminalup-odds-mcp",
  "version": "0.1.0",
  "description": "MCP server for the TerminalUp Odds API: best prices, ladders, liquidity and status across sports trading venues. Stdio and Streamable HTTP.",
  "license": "MIT",
  "author": "TerminalUp Inc. (https://terminalup.com)",
  "homepage": "https://terminalup.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexwooter/terminal-agent-tools.git",
    "directory": "mcp"
  },
  "bugs": {
    "url": "https://github.com/alexwooter/terminal-agent-tools/issues"
  },
  "type": "module",
  "bin": {
    "terminalup-odds-mcp": "dist/stdio.js"
  },
  "main": "dist/server.js",
  "files": [
    "dist",
    "!dist/test",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('fs').chmodSync('dist/stdio.js', 0o755)\"",
    "start": "node dist/http.js",
    "start:stdio": "node dist/stdio.js",
    "dev": "tsx src/http.ts",
    "test": "node --test dist/test/*.test.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "sports",
    "odds",
    "prediction-markets",
    "betting-exchange",
    "terminalup"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
